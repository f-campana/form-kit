# Copy this file to .env.local and fill it in yourself. .env.local is ignored by Git.

# A Scaleway API key whose policy grants TransactionalEmailEmailApiCreate on the Project.
SCW_SECRET_KEY=
# The Scaleway PROJECT id (Console > the project > Project settings), not a database instance id.
SCW_DEFAULT_PROJECT_ID=
# Optional: Transactional Email only runs in fr-par.
# SCW_TEM_REGION=fr-par

# The sender, on the domain checked in Transactional Email, for example formulaire@<your domain>.
FORM_SENDER=
# Your own inbox. Both test emails go there.
FORM_TEST_INBOX=

# Alerts through Amazon SES (pnpm alert-test). A key allowed only ses:SendEmail.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional: eu-north-1 (Stockholm) by default.
# SES_REGION=
# A verified sender, and verified recipients, comma-separated.
ALERT_FROM=
ALERT_TO=

# Setting up a site in the shared database (pnpm provision-site): the administrator's connection.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=verify-full&sslrootcert=/absolute/path/to/instance.pem
# - PASSWORD must be URL-encoded (! %21, / %2F, | %7C, , %2C, @ %40, : %3A, # %23, % %25).
# - HOST, PORT, DATABASE (rdb by default): the instance's Overview page in the Scaleway console.
# - The .pem is specific to each instance: download it from the instance page, keep it outside the repo.
ADMIN_DATABASE_URL=postgres://scaleway:PASSWORD@HOST:PORT/rdb?sslmode=verify-full&sslrootcert=/absolute/path/to/instance.pem
# Optional: a real PostgreSQL server for the 14 extra tests. They create and remove test roles and schemas.
# TEST_DATABASE_URL=
