{
  "name": "form-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Routed contact form kit for small client sites: validation, spam checks, store-then-send delivery, retries, alerts, retention.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "live-test": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/live-test.ts",
    "alert-test": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/alert-test.ts",
    "provision-site": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/provision-site.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@smithy/hash-node": "4.5.2",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
